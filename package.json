{
  "name": "image-caption",
  "author": "jamestoms",
  "repository": {
    "type": "git",
    "url": "https://github.com/jamestoms/image-caption.git"
  },
  
  "version": "0.2.0",
  "description": "基于 fabric.js 的 Vue3 在线图片标注组件（ImageCaption）",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "keywords": [
    "vue3",
    "fabricjs",
    "fabric",
    "image",
    "annotation",
    "label",
    "标注",
    "image caption",
    "image-caption",
    "在线图片标注",
    "数据集标注"
  ],
  "main": "./dist/image-caption.umd.cjs",
  "module": "./dist/image-caption.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/image-caption.js",
      "require": "./dist/image-caption.umd.cjs"
    },
    "./style.css": "./dist/image-caption.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "dependencies": {
    "fabric": "^6.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  }
}
